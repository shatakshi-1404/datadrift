# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=datadrift
POSTGRES_PASSWORD=change_me
POSTGRES_DB=datadrift

# --- Backend ---
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://datadrift:change_me@localhost:5432/datadrift
CORS_ORIGINS=http://localhost:5173

# --- Dataset / model storage ---
DATASET_STORAGE_PATH=storage/datasets
MAX_UPLOAD_SIZE=20971520
MODEL_STORAGE_PATH=storage/models
ML_RANDOM_STATE=42
MLFLOW_TRACKING_URI=mlruns

# --- Drift thresholds ---
KS_PVALUE_THRESHOLD=0.05
PSI_WARNING_THRESHOLD=0.1
PSI_DRIFT_THRESHOLD=0.25
PSI_BUCKETS=10
CHI2_PVALUE_THRESHOLD=0.05

# --- Data quality thresholds ---
MISSING_INCREASE_WARNING_THRESHOLD=5
MISSING_INCREASE_CRITICAL_THRESHOLD=15
DUPLICATE_WARNING_THRESHOLD=1
DUPLICATE_CRITICAL_THRESHOLD=5

# --- Performance monitoring ---
PERFORMANCE_DEGRADATION_THRESHOLD=0.05

# --- Explainability ---
SHAP_BACKGROUND_SAMPLE_SIZE=200
